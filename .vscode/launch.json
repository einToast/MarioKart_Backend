{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "MarioKartBackend",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "mainClass": "de.fsr.mariokart_backend.MarioKartBackendApplication",
      "projectName": "MarioKart_Backend",
      "args": "",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "SEED_EVENT": "${input:seedEvent}"
      }
    }
  ],
  "inputs": [
    {
      "id": "seedEvent",
      "type": "pickString",
      "description": "Event from src/main/resources/seed",
      "options": [
        { "label": "none", "value": "" },
        "demo",
        "registration"
      ],
      "default": ""
    }
  ]
}
