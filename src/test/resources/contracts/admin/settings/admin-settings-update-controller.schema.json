{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/admin/settings/admin-settings-update-controller.schema.json",
  "$defs": {
    "put_root_success": {
      "type": "object",
      "required": ["tournamentOpen", "registrationOpen", "maxGamesCount", "surveyKeyMode"],
      "properties": {
        "tournamentOpen": { "type": "boolean" },
        "registrationOpen": { "type": "boolean" },
        "maxGamesCount": { "type": "integer" },
        "surveyKeyMode": { "type": "string", "enum": ["DISABLED", "DISTRIBUTING", "REQUIRED"] },
        "finalTeamsCount": { "type": ["integer", "null"], "minimum": 2, "maximum": 8 },
        "switches": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["name", "color"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          }
        },
        "floorPlan": { "type": ["string", "null"] },
        "program": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "put_root_error_400": {
      "type": "string",
      "minLength": 1
    },
    "put_root_error_404": {
      "type": "string",
      "minLength": 1
    },
    "put_root_error_409": {
      "type": "string",
      "minLength": 1
    }
  }
}
