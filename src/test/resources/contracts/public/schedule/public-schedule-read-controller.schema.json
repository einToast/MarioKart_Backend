{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/public/schedule/public-schedule-read-controller.schema.json",
  "$defs": {
    "round_return": {
      "type": "object",
      "required": ["id", "roundNumber", "finalGame", "played", "games"],
      "properties": {
        "id": { "type": "integer" },
        "roundNumber": { "type": "integer" },
        "finalGame": { "type": "boolean" },
        "played": { "type": "boolean" },
        "games": { "type": "array" }
      },
      "additionalProperties": true
    },
    "get_rounds_current_success": {
      "type": "array",
      "items": { "$ref": "#/$defs/round_return" }
    },
    "get_overview_success": {
      "type": "object",
      "required": ["currentRounds", "teamsNotInRound", "scheduleCreated", "finalScheduleCreated", "numberOfRoundsUnplayed", "tournamentOpen"],
      "properties": {
        "currentRounds": {
          "type": "array",
          "items": { "$ref": "#/$defs/round_return" }
        },
        "teamsNotInRound": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "teamName"],
              "properties": {
                "id": { "type": "integer" },
                "teamName": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "scheduleCreated": { "type": "boolean" },
        "finalScheduleCreated": { "type": "boolean" },
        "numberOfRoundsUnplayed": { "type": "integer" },
        "tournamentOpen": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "get_rounds_unplayed_success": {
      "type": "integer"
    },
    "get_create_schedule_success": {
      "type": "boolean"
    },
    "get_create_final_schedule_success": {
      "type": "boolean"
    }
  }
}
